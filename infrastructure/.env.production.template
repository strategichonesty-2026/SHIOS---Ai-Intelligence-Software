# SHIOS Production Environment Template
# Copy this to .env and fill in the blanks.
# NEVER commit a filled-in .env to GitHub.

# ── Core ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
# Set automatically by Railway/Render. Override only for manual deploys.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/shios

# ── Events ────────────────────────────────────────────────────────────────
# Set automatically by Railway/Render. Remove if not using Redis.
REDIS_URL=redis://HOST:6379/0
EVENT_CHANNEL=shios.events

# ── Security ──────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=CHANGE_ME_STRONG_RANDOM_VALUE

# Your frontend URL — no trailing slash, no wildcard
CORS_ORIGINS=https://your-frontend.up.railway.app

# ── AI provider ───────────────────────────────────────────────────────────
# 'rule' = deterministic, no external calls, no key required
# 'anthropic' = better prose, needs ANTHROPIC_API_KEY
LLM_PROVIDER=rule
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Sources ───────────────────────────────────────────────────────────────
# sample_jobs = synthetic data (safe for prod, labelled synthetic)
# rss = HackerNews front page
# github = GitHub repo search by topic
# gmail_linkedin_jobs = LinkedIn job alerts via Gmail (requires GMAIL_CREDENTIALS_JSON)
ENABLED_SOURCES=sample_jobs,rss,github
RSS_FEEDS=https://hnrss.org/frontpage
GITHUB_TOPICS=agile,project-management,llm
# Raises GitHub rate limit from 10 to 30 req/min — get at github.com/settings/tokens
GITHUB_TOKEN=
# JSON string of OAuth credentials for Gmail (advanced)
GMAIL_CREDENTIALS_JSON=
GMAIL_QUERY=from:jobalerts-noreply@linkedin.com newer_than:7d

# ── Governance ────────────────────────────────────────────────────────────
MIN_EVIDENCE_PER_RECOMMENDATION=2
MAX_PREDICTION_REVIEW_DAYS=90
MIN_PERIODS_FOR_PREDICTION=3

# ── Scheduler ─────────────────────────────────────────────────────────────
# Enable on exactly ONE backend instance. Multiple instances = duplicate runs.
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MINUTES=360
ANALYZE_INTERVAL_MINUTES=720

# ── Bootstrap ─────────────────────────────────────────────────────────────
# Set true for first deploy only. Set false after first successful run.
BOOTSTRAP_ON_START=true

# ── Frontend (set on frontend service, not backend) ────────────────────────
# NEXT_PUBLIC_API_BASE_URL = your backend public URL + /api/v1
# API_BASE_URL = internal URL (same as public on Railway)
# SHIOS_API_KEY = same as API_KEY above
