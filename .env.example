# ---- Core ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Data layer ----------------------------------------------------------
# Local/demo (no services required):
# DATABASE_URL=sqlite+pysqlite:///./shios.db
DATABASE_URL=postgresql+psycopg://shios:shios@postgres:5432/shios
EMBEDDING_DIM=384

# ---- Events --------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
EVENT_CHANNEL=shios.events

# ---- Security ------------------------------------------------------------
# Leave blank for local development; set to a strong random value everywhere else.
API_KEY=
CORS_ORIGINS=http://localhost:3000

# ---- AI provider ---------------------------------------------------------
# 'rule' runs the whole system deterministically with no external calls.
LLM_PROVIDER=rule
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Sources -------------------------------------------------------------
ENABLED_SOURCES=sample_jobs,rss,github
RSS_FEEDS=https://hnrss.org/frontpage
GITHUB_TOPICS=agile,project-management,llm
GITHUB_TOKEN=
GMAIL_CREDENTIALS_JSON=
GMAIL_QUERY=from:jobalerts-noreply@linkedin.com newer_than:7d

# ---- Governance ----------------------------------------------------------
MIN_EVIDENCE_PER_RECOMMENDATION=2
MAX_PREDICTION_REVIEW_DAYS=90
MIN_PERIODS_FOR_PREDICTION=3

# ---- Scheduler -----------------------------------------------------------
SCHEDULER_ENABLED=false
COLLECT_INTERVAL_MINUTES=360
ANALYZE_INTERVAL_MINUTES=720

# ---- Frontend ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
SHIOS_API_KEY=
